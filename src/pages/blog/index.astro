---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import CTA from '@/components/CTA.astro';
import PhotoStrip from '@/components/PhotoStrip.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const title = 'Blog | Youth Leadership, Gen Z and Education by Wil Massara';
const description = 'Essays by Wil Massara on youth leadership, Gen Z at work, co-design with young people and AI in schools. Written from the road, with the numbers to back it up.';
const [first, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base {title} {description}>
  <section class="frame pt-[calc(var(--nav-h)+48px)]" aria-label="Blog">
    <h1 class="t-head rise">Notes from the road</h1>
    <p class="t-statement mt-8 rise">Youth leadership, Gen Z at work, co-design, AI in schools. Written between flights, with the numbers to back it up.</p>
  </section>
  <section class="frame section" aria-label="Posts">
    {first && <a href={`/blog/${first.id}/`} class="group grid gap-8 bg-field p-8 text-field-ink rise md:grid-cols-12 md:p-12"><div class="md:col-span-7"><p class="t-small">Latest, {first.data.category}</p><h2 class="t-head mt-3 group-hover:text-surface transition-colors">{first.data.title}</h2></div><div class="flex flex-col justify-end md:col-span-5"><p class="t-lead">{first.data.description}</p><p class="t-small mt-6">{fmt(first.data.pubDate)}, {first.data.readingTime} min read</p></div></a>}
    <div class="mt-16 grid gap-x-10 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
      {rest.map((p) => <a href={`/blog/${p.id}/`} class="group block rise"><p class="t-small text-muted">{p.data.category}</p><h2 class="t-lead mt-2 font-extrabold group-hover:text-accent transition-colors">{p.data.title}</h2><p class="t-body mt-3 max-w-[36ch]">{p.data.description}</p><p class="t-small mt-4 text-muted">{fmt(p.data.pubDate)}, {p.data.readingTime} min read</p></a>)}
    </div>
  </section>
  <PhotoStrip set="story" title="From the road" />
  <CTA line="Every post is a keynote waiting to happen. Tell me about your audience." />
</Base>

---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found | Wil Massara" description="That page does not exist." noindex>
  <section class="frame flex min-h-[80svh] flex-col justify-center pt-[calc(var(--nav-h)+48px)]" aria-label="Not found">
    <h1 class="t-head rise">That page isn't here.</h1>
    <p class="t-statement mt-8 rise">It may have moved when the site was rebuilt. Try one of these.</p>
    <div class="mt-8 flex flex-wrap gap-3 rise"><a href="/" class="btn btn-ink">Home</a><a href="/speaking/" class="btn btn-ink">Speaking</a><a href="/blog/" class="btn btn-ink">Blog</a><a href="/book/" class="btn btn-accent">Book Wil</a></div>
  </section>
</Base>

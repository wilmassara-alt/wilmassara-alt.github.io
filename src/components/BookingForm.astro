---
import { TALKS } from '@/data/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<form id="booking-form" action="https://formsubmit.co/hello@wilmassara.com" method="POST" class="grid gap-5 md:grid-cols-2" novalidate>
  <input type="hidden" name="_subject" value="New speaking enquiry via wilmassara.com" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value="https://wilmassara.com/thank-you/" />
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <div><label class="label" for="f-name">Your name</label><input class="field" id="f-name" name="name" type="text" required autocomplete="name" /></div>
  <div><label class="label" for="f-email">Email</label><input class="field" id="f-email" name="email" type="email" required autocomplete="email" /></div>
  <div><label class="label" for="f-org">Organisation</label><input class="field" id="f-org" name="organisation" type="text" autocomplete="organization" /></div>
  <div><label class="label" for="f-role">Your role</label><input class="field" id="f-role" name="role" type="text" autocomplete="organization-title" /></div>
  <div><label class="label" for="f-date">Event date, or rough timing</label><input class="field" id="f-date" name="event_date" type="text" placeholder="14 March 2027, or Term 2" /></div>
  <div><label class="label" for="f-loc">Location</label><input class="field" id="f-loc" name="location" type="text" placeholder="City, country, or virtual" /></div>
  <div><label class="label" for="f-aud">Audience</label>
    <select class="field" id="f-aud" name="audience"><option value="">Select</option><option>Students (primary or secondary)</option><option>Teachers and school leaders</option><option>Corporate or industry conference</option><option>HR, people and leadership teams</option><option>Government, council or youth sector</option><option>Graduate or early-career cohort</option><option>Mixed or other</option></select></div>
  <div><label class="label" for="f-size">Audience size</label>
    <select class="field" id="f-size" name="audience_size"><option value="">Select</option><option>Under 50</option><option>50 to 200</option><option>200 to 500</option><option>500 to 1,500</option><option>1,500+</option></select></div>
  <div><label class="label" for="f-format">Format</label>
    <select class="field" id="f-format" name="format"><option value="">Select</option><option>Keynote</option><option>Workshop</option><option>Keynote plus workshop</option><option>Panel or fireside</option><option>MC or host</option><option>Virtual</option><option>Not sure yet</option></select></div>
  <div><label class="label" for="f-topic">Topic of interest</label>
    <select class="field" id="f-topic" name="topic"><option value="">Select</option>{TALKS.map((t) => <option>{t.title}</option>)}<option>Something tailored</option></select></div>
  {!compact && <div><label class="label" for="f-budget">Budget range (optional)</label><select class="field" id="f-budget" name="budget"><option value="">Prefer not to say yet</option><option>Under A$5,000</option><option>A$5,000 to A$10,000</option><option>A$10,000 to A$20,000</option><option>A$20,000+</option><option>Not sure, please advise</option></select></div>}
  {!compact && <div><label class="label" for="f-heard">How did you hear about Wil?</label><input class="field" id="f-heard" name="heard_from" type="text" placeholder="LinkedIn, a colleague, Google, an event" /></div>}
  <div class="md:col-span-2"><label class="label" for="f-msg">Tell me about the event</label><textarea class="field min-h-[140px]" id="f-msg" name="message" required placeholder="What is the event, who is in the room, and what do you want them to walk out with?"></textarea></div>
  <div class="md:col-span-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="t-small text-muted">Goes straight to hello@wilmassara.com. Reply within one business day.</p>
    <button type="submit" class="btn btn-accent">Send enquiry</button>
  </div>
  <p id="form-status" class="md:col-span-2 hidden bg-field px-5 py-4 text-field-ink" role="status" aria-live="polite"></p>
</form>
<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Sending';
    try {
      const data = Object.fromEntries(new FormData(form).entries());
      const res = await fetch('https://formsubmit.co/ajax/hello@wilmassara.com', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) });
      const json = await res.json().catch(() => ({}));
      if (res.ok && (json.success === 'true' || json.success === true)) window.location.href = '/thank-you/';
      else throw new Error(json.message || 'Form service rejected the submission');
    } catch {
      status.classList.remove('hidden');
      status.textContent = 'That did not send. Please email hello@wilmassara.com directly and I will get straight back to you.';
      btn.disabled = false; btn.textContent = 'Try again';
    }
  });
</script>

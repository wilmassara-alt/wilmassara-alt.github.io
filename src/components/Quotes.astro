---
import { Image } from 'astro:assets';
import { TESTIMONIALS } from '@/data/site';
import heart from '@/assets/photos/stage-heart.jpg';
---
<!-- One screen: a stage portrait on the left, the three quotations stacked on the right. -->
<section class="frame section grid gap-10 md:grid-cols-12 md:items-start" aria-labelledby="quotes-h">
  <div class="md:col-span-4">
    <h2 id="quotes-h" class="t-head rise">Organisers say</h2>
    <div class="pic pic-drift mt-8 aspect-[4/5] w-[70%] rise md:w-full"><Image src={heart} alt="Wil Massara on stage, hand on heart" width={900} class="h-full w-full object-cover" /></div>
  </div>
  <div class="space-y-10 md:col-span-7 md:col-start-6 md:pt-3">
    {TESTIMONIALS.map((t) => (
      <figure class="rise">
        <blockquote class="t-lead max-w-[36ch] font-extrabold leading-tight">{t.quote}</blockquote>
        <figcaption class="mt-3 t-small text-muted">{t.name}, {t.role}, {t.org}</figcaption>
      </figure>
    ))}
  </div>
</section>

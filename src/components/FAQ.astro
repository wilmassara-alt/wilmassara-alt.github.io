---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions organisers ask' } = Astro.props;
---
<div>
  <h2 class="t-head max-w-[14ch] rise">{title}</h2>
  <div class="mt-20 md:ml-[33%]">
    {items.map((f) => (
      <details class="faq-row rise">
        <summary><span>{f.q}</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg></summary>
        <div class="faq-body"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</div>
